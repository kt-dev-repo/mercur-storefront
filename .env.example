# Storefront configuration.
#
# Every NEXT_PUBLIC_* value is COMPILED INTO THE BUNDLE AT BUILD TIME. Changing one
# needs a rebuild, not a restart — a restart silently keeps serving the old value.
# Only MEDUSA_BACKEND_URL and REVALIDATE_SECRET are read at runtime.

# --- The marketplace backend -----------------------------------------------
# Server-side calls to the API. Inside a Compose network this is the service
# name; from a browser it must be the public origin.
MEDUSA_BACKEND_URL=http://localhost:9000

# Created by the backend's seed. Find it in the admin panel under
# Settings -> Publishable API keys, or in the seed output. The store API
# refuses every request without it.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# This storefront's own public origin. Must match MERCUR_STOREFRONT_URL in the
# backend, which is what customer password-reset links are built from.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Where "sell on our marketplace" links send a prospective vendor. Matches
# MERCUR_VENDOR_URL in the backend.
NEXT_PUBLIC_VENDOR_URL=http://localhost:7001

# ISO country code of the region to fall back to when none is chosen. Must be a
# country the backend actually has a region for, or pages 404.
NEXT_PUBLIC_DEFAULT_REGION=de

# --- Cache revalidation ----------------------------------------------------
# Shared secret the backend presents when it asks this storefront to drop cached
# pages. MUST equal STOREFRONT_REVALIDATE_SECRET in the backend, and the backend's
# STOREFRONT_REVALIDATE_URL must point at this deployment. If they disagree the
# hook fails quietly and the storefront serves stale pages indefinitely.
REVALIDATE_SECRET=CHANGE_ME

# --- Stripe ----------------------------------------------------------------
# The PUBLISHABLE key (pk_test_... / pk_live_...), not the secret key. The secret
# key belongs only in the backend, as STRIPE_API_KEY. Publishing a secret key here
# would put it in the browser bundle.
NEXT_PUBLIC_STRIPE_KEY=pk_test_...

# --- Branding --------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Your Marketplace"
NEXT_PUBLIC_SITE_DESCRIPTION="A multi-vendor marketplace"
