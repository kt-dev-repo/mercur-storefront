# Storefront deployment environment (Dokploy).
#
# Paste this into the Dokploy service's Environment tab and fill it in. This is a
# SEPARATE deployment from the marketplace backend, on its own hostname; the two are
# joined by the variables below and by nothing else.
#
# Every row here has a counterpart in the backend's environment. When a pair disagrees
# the feature fails QUIETLY — no error page, no log line — so check them against each
# other rather than against your memory of what you typed.
#
#   Storefront (this file)              Backend (deploy/.env.example there)
#   ----------------------------------  ------------------------------------------
#   MEDUSA_BACKEND_URL                  the backend's own public origin
#   NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY  a publishable key issued by that backend
#   NEXT_PUBLIC_BASE_URL                MERCUR_STOREFRONT_URL
#   NEXT_PUBLIC_VENDOR_URL              MERCUR_VENDOR_URL
#   REVALIDATE_SECRET                   STOREFRONT_REVALIDATE_SECRET
#   (this deployment's /api/revalidate) STOREFRONT_REVALIDATE_URL
#   NEXT_PUBLIC_STRIPE_KEY              the publishable twin of STRIPE_API_KEY

# --- Routing ---------------------------------------------------------------
# The hostname Traefik routes to this storefront. Bare host, no scheme, no
# trailing slash. Must differ from the backend stack's DOMAIN.
DOMAIN=shop.example.com

# Distinguishes this stack's Traefik routers from the backend's. Leave it alone
# unless you run more than one storefront against the same Traefik.
TRAEFIK_ROUTER=storefront

# --- The marketplace backend -----------------------------------------------
# The backend's public origin, scheme included. Used for server-side API calls.
# If the backend is on the same dokploy-network you may instead use its service
# name, e.g. http://backend:9000.
MEDUSA_BACKEND_URL=https://api.example.com

# Issued by the backend: admin panel -> Settings -> Publishable API keys, or read
# from its seed output. Every /store request without it is rejected with a 400.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# --- This storefront's own identity ----------------------------------------
# Must equal MERCUR_STOREFRONT_URL in the backend. That is what customer
# password-reset links are built from: if the backend's copy is unset, the reset
# email still arrives but carries no link at all.
NEXT_PUBLIC_BASE_URL=https://shop.example.com

# Where "sell with us" sends a prospective vendor. Equals MERCUR_VENDOR_URL in
# the backend, which is the backend origin + /seller unless hosted separately.
NEXT_PUBLIC_VENDOR_URL=https://api.example.com/seller

# ISO country code to fall back to when no region is chosen. It MUST be a country
# the backend actually has a region for, or every page 404s. The stock seed
# creates one region, "Europe", covering de, dk, es, fr, gb, it and se.
NEXT_PUBLIC_DEFAULT_REGION=de

# --- Cache revalidation ----------------------------------------------------
# Shared secret, sent by the backend as the x-revalidate-secret header. MUST be
# byte-identical to STOREFRONT_REVALIDATE_SECRET in the backend; a mismatch is
# answered 401 and the storefront then serves stale pages indefinitely.
#   openssl rand -hex 32
REVALIDATE_SECRET=

# Set the OTHER side of this in the backend's environment, and mind the path:
#
#   STOREFRONT_REVALIDATE_URL=https://shop.example.com/api/revalidate
#
# The backend POSTs to that URL verbatim. Pointed at the bare origin it hits the
# locale middleware and gets a 307 redirect, which is not a success — every
# product event then logs "revalidation rejected: 307" and nothing is revalidated.

# --- Stripe ----------------------------------------------------------------
# The PUBLISHABLE key (pk_live_... / pk_test_...). The secret key (sk_...) belongs
# only in the backend as STRIPE_API_KEY — anything NEXT_PUBLIC_* is compiled into
# the browser bundle and is public.
#
# Leave empty unless the backend also has PAYMENTS=stripe; with the default stub
# provider there is nothing for Stripe elements to mount against.
NEXT_PUBLIC_STRIPE_KEY=

# --- Branding --------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Your Marketplace"
NEXT_PUBLIC_SITE_DESCRIPTION="A multi-vendor marketplace"

# Reminder: every NEXT_PUBLIC_* above is baked in at BUILD time. Changing one
# requires a Rebuild in Dokploy, not a Restart — a restart keeps serving the old
# value with no indication anything is stale.
